{
  "name": "passion-bakery-chocolates",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "tsc --noEmit",
    "cap:sync": "npm run build && node -e \"require('fs').rmSync('out/admin',{recursive:true,force:true})\" && npx cap sync android",
    "cap:open": "npx cap open android",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "prepare:content": "node scripts/build-products.mjs && node scripts/copy-decap.mjs",
    "predev": "npm run prepare:content",
    "prebuild": "npm run prepare:content",
    "cms": "decap-server",
    "dev:cms": "concurrently -k -n site,cms \"next dev\" \"decap-server\""
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/app-launcher": "^7.0.4",
    "@capacitor/browser": "^7.0.5",
    "@fontsource/delius": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "decap-cms": "^3.16.3",
    "decap-server": "^3.11.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.2"
  }
}
